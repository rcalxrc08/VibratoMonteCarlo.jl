\begin{equation}
\frac{\partial^{6} V}{\partial\theta^{6}} = \mathbb{E}\left( \frac{\left(  - 15 T^{3} + 45 W_T^{2} T^{2} - 15 W_T^{4} T + W_T^{6} \right) \Phi\left( \log\left( S_0 \right) + W_T \sigma + T \left(  - d + r - \frac{1}{2} \sigma^{2} \right) \right)}{\sigma^{6}} \right)
\end{equation}

